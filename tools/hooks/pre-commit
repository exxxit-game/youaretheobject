#!/bin/sh
# A commit is checked in seconds, so saving often (the power is cut daily) costs nothing: nothing
# private is staged (tools/secrets.mjs --staged), every staged script parses, and the quick tests
# of npm test pass. The slow ones (SLOW) run at push; all, and the smoke test, on GitHub. Set once per clone: git config core.hooksPath tools/hooks
SLOW='structure review-gate'
# not a check of what is committed: the library test reads the owner's papers folder, and papers a search
# saved there stopped commits of the game; it runs in npm test
NOT_COMMIT='library'
stop() { echo "STOP  the commit check fails: $1; nothing was committed"; exit 1; }
# read before git's own variables go: for "commit -a" GIT_INDEX_FILE names what is being committed
staged=$(git diff --cached --name-only --diff-filter=ACMR -- '*.js' '*.mjs')
node tools/secrets.mjs --staged > /dev/null 2>&1 || stop "something private is staged or git signs with another address (node tools/secrets.mjs --staged)"
git show :docs/features.json 2>/dev/null | node tools/claude-guard.mjs accepted || stop "features.json: a pass or a drop with no acceptance of his naming its number in 3 hours (CLAUDE.md step 5), or a parse error"
# Keep Git's index selection until staged syntax is checked (commit -a uses a temporary index).
while IFS= read -r f; do
  [ -n "$f" ] || continue
  code=$(git show ":$f") || stop "$f cannot be read from the index"
  printf '%s\n' "$code" | node --check --input-type=module > /dev/null 2>&1 || stop "$f does not parse (staged version)"
done <<EOF
$staged
EOF
# Isolate test repositories from Git's hook environment.
unset GIT_DIR GIT_INDEX_FILE GIT_WORK_TREE GIT_PREFIX GIT_EDITOR
# One process at a time: the owner's two-core laptop must remain responsive.
for t in $(grep -o 'node tests/[a-z0-9.-]*\.test\.mjs' package.json | cut -c6-); do
  case " $SLOW $NOT_COMMIT " in *" $(basename "$t" .test.mjs) "*) continue ;; esac
  node "$t" > /dev/null 2>&1 || stop "$t fails (node $t)"
done
exit 0
